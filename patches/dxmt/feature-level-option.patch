From ed9ceb7c0c6b14d5a375b678f589b460621d96ef Mon Sep 17 00:00:00 2001
From: Feifan He <feifan@codeweavers.com>
Date: Tue, 28 Apr 2026 14:06:10 +0800
Subject: [PATCH] feat(d3d11): introduce `d3d11.maxFeatureLevel` option

Signed-off-by: Feifan He <feifan@codeweavers.com>
---
 dxmt.conf                  |  6 ++++++
 src/d3d11/d3d11.cpp        | 37 +++++++++++++++++++++++++++++++++++++
 src/util/config/config.cpp |  4 ++++
 3 files changed, 47 insertions(+)

diff --git a/dxmt.conf b/dxmt.conf
index 41a8f0f24..7a4da507b 100644
--- a/dxmt.conf
+++ b/dxmt.conf
@@ -91,3 +91,9 @@
 #
 
 # d3d11.defuseFma = False
+
+# Override the maximum feature level of created d3d11 device.
+#
+# Supported values: 9_1, 9_2, 9_3, 10_0, 10_1, 11_0, 11_1, 12_0, 12_1
+
+# d3d11.maxFeatureLevel = 12_1
diff --git a/src/d3d11/d3d11.cpp b/src/d3d11/d3d11.cpp
index 0550862b5..c20449c7b 100644
--- a/src/d3d11/d3d11.cpp
+++ b/src/d3d11/d3d11.cpp
@@ -1,6 +1,25 @@
