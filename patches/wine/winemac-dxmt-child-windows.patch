+static struct external_win_data *external_child_win_data(HWND hwnd)
+{
+    struct external_win_data *ret;
+    struct client_surface *client;
+    DWORD root_pid = 0;
+
+    NtUserGetWindowThread(NtUserGetAncestor(hwnd, GA_ROOT), &root_pid);
+    if (root_pid != GetCurrentProcessId()) return NULL;
+    if (!(client = macdrv_CreateClientSurface(hwnd, 0, FALSE))) return NULL;
+    if (!(ret = calloc(1, sizeof(*ret))) || !add_child_surface(client))
+    {
+        free(ret);
+        client_surface_release(client);
+        return NULL;
+    }
+    TRACE("hwnd %p: child surface %p\n", hwnd, client);
+    ret->hwnd = hwnd;
+    ret->cocoa_view = impl_from_client_surface(client)->cocoa_view;
+    ret->client_cocoa_view = ret->cocoa_view;
+    ret->child_surface = client;
+    return ret;
+}
