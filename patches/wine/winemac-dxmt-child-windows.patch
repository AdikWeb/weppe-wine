     if (data->drag_event) NtSetEvent(data->drag_event, NULL);
@@ -1849,6 +1978,7 @@
     if (!(data = get_win_data(hwnd)))
     {
         update_hosted_remote_layers(hwnd);
+        update_child_surfaces(hwnd);
