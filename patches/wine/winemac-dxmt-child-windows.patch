Let DXMT present into child windows of its own process.

A child window has no Cocoa window, so the external window data handed DXMT
nothing and it dereferenced NULL. Give such a window a client surface over its
area of the top-level window, as Vulkan and OpenGL get one, and keep it placed
when windows move, resize or are destroyed.

--- a/dlls/winemac.drv/window.c	2026-10-14 07:08:53.346910728 +0500
+++ b/dlls/winemac.drv/window.c	2026-10-14 07:09:48.422716951 +0500
@@ -648,6 +648,134 @@
     free(items);
 }
 
+struct child_surface
+{
+    struct client_surface *client;
+    WineContentView       *view;
+    WineMetalView         *metal_view;
+};
+
+static pthread_mutex_t child_surfaces_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct child_surface *child_surfaces;
+static unsigned int child_surface_count, child_surface_capacity;
+
+static BOOL add_child_surface(struct client_surface *client)
+{
+    BOOL added = FALSE;
+
+    pthread_mutex_lock(&child_surfaces_mutex);
+    if (child_surface_count == child_surface_capacity)
+    {
+        unsigned int capacity = max(16, child_surface_capacity * 2);
+        struct child_surface *items = realloc(child_surfaces, capacity * sizeof(*items));
+        if (items)
+        {
+            child_surfaces = items;
+            child_surface_capacity = capacity;
+        }
+    }
+    if (child_surface_count < child_surface_capacity)
+    {
+        child_surfaces[child_surface_count].client = client;
+        child_surfaces[child_surface_count].view = impl_from_client_surface(client)->cocoa_view;
+        child_surfaces[child_surface_count].metal_view = NULL;
+        child_surface_count++;
+        added = TRUE;
+    }
+    pthread_mutex_unlock(&child_surfaces_mutex);
+    return added;
+}
+
+static void set_child_surface_metal_view(WineContentView *view, WineMetalView *metal_view)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&child_surfaces_mutex);
+    for (i = 0; i < child_surface_count; i++)
+    {
+        if (child_surfaces[i].view != view || child_surfaces[i].metal_view) continue;
+        child_surfaces[i].metal_view = metal_view;
+        break;
+    }
+    pthread_mutex_unlock(&child_surfaces_mutex);
+}
+
+static struct client_surface *take_child_surface(struct client_surface *client, WineMetalView *metal_view)
+{
+    struct client_surface *taken = NULL;
+    unsigned int i;
+
+    pthread_mutex_lock(&child_surfaces_mutex);
+    for (i = 0; i < child_surface_count; i++)
+    {
+        if (metal_view ? child_surfaces[i].metal_view != metal_view
+                       : child_surfaces[i].client != client || child_surfaces[i].metal_view) continue;
+        taken = child_surfaces[i].client;
+        child_surfaces[i] = child_surfaces[--child_surface_count];
+        break;
+    }
+    pthread_mutex_unlock(&child_surfaces_mutex);
+    return taken;
+}
+
+static struct client_surface **child_surfaces_matching(HWND hwnd, BOOL whole_tree, unsigned int *count)
+{
+    struct client_surface **ret;
+    unsigned int all = 0, i;
+    HWND key = whole_tree ? NtUserGetAncestor(hwnd, GA_ROOT) : hwnd;
+
+    *count = 0;
+    pthread_mutex_lock(&child_surfaces_mutex);
+    if ((ret = malloc(max(1, child_surface_count) * sizeof(*ret))))
+    {
+        for (i = 0; i < child_surface_count; i++)
+        {
+            client_surface_add_ref(child_surfaces[i].client);
+            ret[all++] = child_surfaces[i].client;
+        }
+    }
+    pthread_mutex_unlock(&child_surfaces_mutex);
+    if (!ret) return NULL;
+
+    for (i = 0; i < all; i++)
+    {
+        HWND surface_hwnd = ret[i]->hwnd;
+        if (surface_hwnd && (whole_tree ? NtUserGetAncestor(surface_hwnd, GA_ROOT) : surface_hwnd) == key)
+            ret[(*count)++] = ret[i];
+        else
+            client_surface_release(ret[i]);
+    }
+    return ret;
+}
+
+static void update_child_surfaces(HWND hwnd)
+{
+    struct client_surface **clients;
+    unsigned int count, i;
+
+    if (!(clients = child_surfaces_matching(hwnd, TRUE, &count))) return;
+    for (i = 0; i < count; i++)
+    {
+        if (NtUserIsWindow(clients[i]->hwnd)) client_surface_present(clients[i]);
+        client_surface_release(clients[i]);
+    }
+    free(clients);
+}
+
+static void hide_child_surfaces(HWND hwnd)
+{
+    struct client_surface **clients;
+    unsigned int count, i;
+
+    if (!(clients = child_surfaces_matching(hwnd, FALSE, &count))) return;
+    for (i = 0; i < count; i++)
+    {
+        macdrv_set_view_hidden(impl_from_client_surface(clients[i])->cocoa_view, TRUE);
+        client_surface_release(clients[i]);
+    }
+    free(clients);
+}
